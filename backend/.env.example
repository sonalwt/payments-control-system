NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=pcs
DB_SCHEMA=public
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h

# Employee self-service portal (passwordless OTP login)
EMPLOYEE_JWT_EXPIRES_IN=2h
EMPLOYEE_OTP_TTL_MINUTES=10
EMPLOYEE_OTP_MAX_ATTEMPTS=5

# CORS
CORS_ORIGIN=http://localhost:3000

# AWS S3 (document storage)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: set only for S3-compatible services (MinIO, LocalStack, etc.)
# AWS_S3_ENDPOINT=http://localhost:9000
# Public base URL of the frontend (used to build links in emails)
FRONTEND_URL=http://localhost:3000

# Password-reset OTP recipient. Reset codes are always emailed to an admin,
# never to the requesting user. Set a fixed address here, or leave empty to
# send the code to every active platform admin.
ADMIN_EMAIL=

# Invoicing-app webhook (POST /api/v1/webhooks/invoices).
# OPTIONAL service account that integration-created payment requests are
# attributed to until a maker classifies and claims them. It needs no maker
# role. Leave empty and created_by stays null until a maker claims the draft —
# the origin is recorded in external_source/external_reference either way, and
# the webhook works normally. Set it only if every row must name a user.
INTEGRATION_MAKER_EMAIL=
# Payment category invoices from the integration belong to. A maker classifying
# one of these drafts may only choose a payment type in this category, so an
# inbound supplier invoice cannot be routed down an unrelated approval chain.
# Matched on payment_categories.name. Empty disables the restriction.
INTEGRATION_PAYMENT_CATEGORY=Trade Payments

# SMTP (password-reset emails). Leave SMTP_HOST empty to log the reset link
# to the server console instead of sending a real email (dev fallback).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Per-environment secrets — set these in the real .env, never in this file.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Payments Control System <no-reply@pcs.local>
